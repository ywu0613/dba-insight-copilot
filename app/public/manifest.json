{
  "manifest_version": 3,
  "name": "DBA Insight Copilot",
  "version": "1.0",
  "description": "A sidebar extension to analyze AWR/HTML reports for DBAs.",
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "action": {
    "default_title": "Open DBA Insight Copilot"
  },
  "icons": {
    "16": "vite.svg",
    "48": "vite.svg",
    "128": "vite.svg"
  }
}
